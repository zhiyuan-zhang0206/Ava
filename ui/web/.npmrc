# eslint-plugin-jsx-a11y has not yet published an ESLint 10 peer range.
# Note: legacy-peer-deps also stops npm from installing peer dependencies of
# dependencies, so a peer-only tool (vitest 5 moved `vite` to a peer) must stay
# declared in package.json — dropping it fails the run with ERR_MODULE_NOT_FOUND.
legacy-peer-deps=true
