{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing exploratory config — only runs core logic (timeline / sticky / store), not part of CI.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["progress", "clear-text", "html", "json"],
  "mutate": ["src/components/timeline.tsx"],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": null
  }
}
