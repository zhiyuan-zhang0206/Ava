# Build output.
/target/

# Generated by tauri-build on every compile: JSON schemas for the capability
# files and the `allow-*`/`deny-*` permission stubs derived from
# src/command_names.rs. Both are outputs of checked-in inputs.
/gen/schemas/
/permissions/autogenerated/

# Generated by `cargo tauri android init` in CI, then patched by
# ../android/apply_overlay.py. Regenerated per build rather than committed, so
# the Android project never drifts from the Tauri version that produced it.
/gen/android/
/gen/apple/
