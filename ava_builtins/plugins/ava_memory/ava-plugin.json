{
  "apiVersion": 2,
  "name": "ava_memory",
  "version": "1.0.0",
  "engines": {
    "ava": ">=2026.10.1"
  },
  "contributions": {
    "hooks": [
      "before_llm"
    ],
    "sdkNamespaces": [
      "memory"
    ],
    "systemPromptSections": [
      "memory_discipline_section"
    ],
    "metrics": [
      "ava_memory_recall_filter_runs",
      "ava_memory_recall_search_latency_ms",
      "ava_memory_recall_filter_latency_ms",
      "ava_memory_recall_filter_empty_rate",
      "ava_memory_recall_filter_anomaly_rate",
      "ava_memory_recall_filter_failures",
      "ava_memory_recall_filter_agent_runs"
    ],
    "config": {
      "schema": "default_config.py"
    }
  }
}
