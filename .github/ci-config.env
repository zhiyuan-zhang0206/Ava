# Ava CI 参数唯一来源（S1/S2, #1176）
#
# 修改默认值 = 改本文件开 PR（可 review、可追溯）。运行时临时调参暂不开放
# （单 owner repo，PR 流程足够快）；开源后如需免 PR 调参再切 repo variables。
# 每个参数：KEY=VALUE + 语义 + 调节方向 + 风险。workflow 读取本文件时带
# ${VAR:-默认} 防御——文件缺失或键缺失时回退到安全默认（全量更频繁而非更少）。
#
# 参数间关系：FULL_CI_EVERY_N_COMMITS 调大 ⇒ NIGHTLY_ENABLED 必须保持 true
# （nightly 是抽样/降频方案的置信度基线）。
#
# ⚠️ 硬约束：本文件被 workflow 的解析器读取（逐行 KEY=VALUE 提取并 export，
# 绝不执行文件内容——#1176 首日事故 NIGHTLY_CRON=0 17 * * * 被 source 当命令
# 执行 exit 127 后改为解析器）。非 KEY=VALUE 行会被忽略 + ::warning，请保持
# 文件为纯 KEY=VALUE + 注释。

# push:main 每累计 N 个 commits 跑一次全量（git rev-list --count HEAD 取模，
# 无状态、确定性）。Ava 日均 ~105 commits ≈ 7-10 个 PR → N=100 ≈ 每 10 个 PR /
# 每天约 1 次全量。大 PR（多 commits）自动更易命中——"改动越大越该全量"。
# 调小：全量更频繁、更稳更贵；调大：省 CI 分钟，组合 bug 滞留到 nightly。
FULL_CI_EVERY_N_COMMITS=100

# 非 full 且非 e2e-trigger 的 PR，按此百分比抽样跑 e2e（commit sha 哈希取模，
# 确定性——同一 commit 结果稳定可复现）。0 = 仅 full/e2e-trigger 跑；
# 100 = 所有 PR 都跑。e2e 是单 worker 串行的最贵 job，是 PR 关键路径。
# e2e-trigger 契约路径（timeline/marker 等）无视本参数必跑。
E2E_SAMPLE_RATE_PCT=30

# nightly 全量兜底总开关（true/false）。FULL_CI_EVERY_N_COMMITS 调大时必须
# 保持 true，否则降频的合入将无任何全量覆盖。不建议关。
NIGHTLY_ENABLED=true

# nightly 触发时间（仅文档——GitHub Actions schedule cron 必须是字面量，
# 实际值在 .github/workflows/nightly.yml 的 cron 行；改时间两处同步）。
# ⚠️ 必须保持注释状态：本文件被 shell source，裸 cron 表达式会被当作命令执行
# （#1176 首日事故：NIGHTLY_CRON=0 17 * * * → "17: command not found"，exit 127）。
# NIGHTLY_CRON=0 17 * * *

# nightly 中 flaky 测试（pytest -m flaky + vitest flaky config）失败重试次数。
# PR CI 不重试；nightly 给 flaky 组多一次机会（shell 级重跑，无插件依赖）。
NIGHTLY_FLAKY_RETRIES=2
