{
  "apiVersion": 2,
  "name": "meiva_memory",
  "version": "1.0.0",
  "engines": {
    "meiva": ">=2026.10.1"
  },
  "contributions": {
    "hooks": [
      "before_llm",
      "after_exec"
    ],
    "sdkNamespaces": [
      "memory"
    ],
    "sdkWraps": [
      "files.write",
      "files.append",
      "files.edit"
    ],
    "systemPromptSections": [
      "memory_discipline_section"
    ],
    "metrics": [
      "meiva_memory_recall_runs",
      "meiva_memory_recall_search_latency_ms",
      "meiva_memory_recall_injected_notes",
      "meiva_memory_recall_empty_rate",
      "meiva_memory_recall_deadline_skip_rate",
      "meiva_memory_recall_deadline_skips",
      "meiva_memory_recall_agent_runs"
    ],
    "config": {
      "schema": "default_config.py"
    }
  }
}
