# Mainland-China mirror profile for package acquisition on restricted networks.
#
# Every line is a plain KEY=VALUE that the underlying tool already honors; there
# is no Ava-specific machinery here. Export it into the shell that acquires
# dependencies and builds the frontend
# (.agents/skills/ava-guide/deploy/references/mirrors-cn.md):
#
#   set -a; . scripts/mirrors/cn.env; set +a
#
# Nothing copies it into a home, selects a home or starts a cluster. A unit's
# existing `$AVA_HOME/mirror.env` still loads for every `ava` command, below the
# real environment and `.env`.
#
# Only stable institutional mirrors are baked in (Tsinghua TUNA + npmmirror).
# Two legs are GitHub-release-backed and have no canonical CN mirror: the `uv`
# binary itself and uv's managed CPython download. Acquire them through trusted,
# verified transport; if a download stalls, set UV_PYTHON_INSTALL_MIRROR (and,
# for the uv installer, UV_INSTALLER_GITHUB_BASE_URL) to a GitHub proxy you
# trust.

# Python download index for the shared locked installer. It validates the
# canonical PyPI lock, then exports pinned requirements with hashes and lets uv
# fetch matching artifacts here. The repository lock is never re-resolved or
# rewritten for a machine. Existing machine uv/pip index settings are also read
# when no explicit profile/environment overrides them.
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# npm registry for the frontend's `npm ci` (run in the exported shell, or by
# `ava start` when the unit's `mirror.env` carries it).
# Transport only: the committed ui/web/package-lock.json keeps canonical
# registry.npmjs.org origins (npm rewrites the fetch host to this registry at
# install time), so a mirror URL must never be written back into the lock;
# scripts/lint/package_lock.py enforces exactly that.
npm_config_registry=https://registry.npmmirror.com

# Homebrew bottles + formulae API (macOS host packages).
HOMEBREW_API_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api
HOMEBREW_BOTTLE_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles
