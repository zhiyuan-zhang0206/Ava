diff --git a/shared/retained-legacy.ava.okf.md b/shared/retained-legacy.ava.okf.md
new file mode 100644
index 000000000..f4558e4cb
--- /dev/null
+++ b/shared/retained-legacy.ava.okf.md
@@ -0,0 +1,37 @@
+---
+type: doc
+title: Retained legacy runtime path compatibility
+description: Fixed-base legacy wheel path bindings without lifecycle or schema permission.
+---
+
+# Retained legacy runtime path compatibility
+
+This compatibility patch targets base
+`612326d130fdc5322e40cb8e688e8ba623d9bc5d`. It is not the unmodified base
+release. A build must record that base, the exact compatibility patch hash,
+the reconstructed tree and wheel/image digests. A synthetic PR merge built
+with newer application code is not evidence for the legacy artifact.
+
+`shared.retained_legacy` is Settings-free. A loaded wheel uses its resolved
+venv prefix under `<unit>/releases/<64-hex>/venv`. Before dotenv or normal
+service imports, it requires explicit canonical `AVA_HOME` equal to that unit.
+The developer checkout path retains its existing semantics. The legacy
+override flag cannot redirect an installed image to another home.
+
+External plugin discovery reads the loaded generation's `plugins` directory.
+Package installation, scaffolding, configuration and user memory retain their
+existing mutable home destinations. The read resolver does not create a plugin
+directory or change the loaded root when an environment variable changes.
+
+These bindings do not verify an image seal, grant an operation lease, select
+a release, migrate a database or permit agent admission. The verified builder
+and existing lifecycle retain those responsibilities. The old exact applied
+migration-set check and unknown wheel `process_sha` remain unchanged.
+
+Cold boot evidence must use the reconstructed legacy wheel, no source checkout,
+an actual private home and compatible schema. It must observe the real normal
+ops process, native readiness and loaded image origin, and reject wrong home
+and schema. Contract tests alone do not establish this. A bootable artifact is
+not a complete LKG: safe down-migration and persisted message/protocol readability
+are separate required rollback gates. Correct refusal to roll back existing
+data means automatic legacy rollback is unavailable for that state.
diff --git a/shared/retained_legacy.py b/shared/retained_legacy.py
new file mode 100644
index 000000000..c85c4899d
--- /dev/null
+++ b/shared/retained_legacy.py
@@ -0,0 +1,77 @@
+"""Narrow legacy-image path compatibility, not rollout or schema permission.
+
+The image builder verifies/seals bytes. This early, Settings-free reader binds
+the loaded wheel to its private retained unit before normal imports can create
+pid/config paths. Development checkout semantics remain unchanged.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+_PREFIX = Path(sys.prefix).resolve()
+_INSTALLED = Path(__file__).resolve().is_relative_to(_PREFIX)
+
+
+def retained_home() -> Path | None:
+    """Return the loaded generation's unit, never an environment-selected home."""
+    if not _INSTALLED:
+        return None
+    if sys.prefix == sys.base_prefix or _PREFIX.name != "venv":
+        raise RuntimeError("legacy retained runtime requires its private generation venv")
+    image = _PREFIX.parent
+    if (
+        image.parent.name != "releases"
+        or len(image.name) != 64
+        or any(c not in "0123456789abcdef" for c in image.name)
+    ):
+        raise RuntimeError("legacy retained runtime is outside a canonical release image")
+    return image.parent.parent
+
+
+def external_plugin_read_root() -> Path:
+    """Discovery reads retained bytes; installer/scaffold destinations stay mutable."""
+    if retained_home() is not None:
+        return _PREFIX.parent / "plugins"
+    from shared.paths import plugins_dir
+
+    return plugins_dir()
+
+
+def retained_migration_paths(root: Path) -> set[Path] | None:
+    """Read exact built SQL inventory; never infer permission to execute SQL."""
+    if retained_home() is None:
+        return None
+    package = Path(__file__).resolve().parent.parent
+    if root.resolve() != package / "migrations":
+        raise RuntimeError("legacy SQL inventory root differs from loaded package")
+    receipt = package / "shared/legacy_inventory.json"
+    if receipt.is_symlink() or not receipt.is_file():
+        raise RuntimeError("legacy wheel lacks its fixed-build SQL inventory")
+    value = json.loads(receipt.read_bytes())
+    if set(value) != {"base_sha", "patch_sha256", "build_tree", "sql"}:
+        raise RuntimeError("legacy SQL inventory has unknown fields")
+    if value["base_sha"] != "612326d130fdc5322e40cb8e688e8ba623d9bc5d":
+        raise RuntimeError("legacy SQL inventory has a different base")
+    expected = value["sql"]
+    if not isinstance(expected, dict) or "db/schema.sql" not in expected:
+        raise RuntimeError("legacy SQL inventory lacks the baseline")
+    actual = {p.relative_to(package).as_posix() for p in root.rglob("*.sql")}
+    if set(expected) != actual | {"db/schema.sql"}:
+        raise RuntimeError("legacy SQL inventory membership changed")
+    for name, digest in expected.items():
+        path = package / name
+        if path.is_symlink() or not path.is_file() or path.resolve() != path:
+            raise RuntimeError("legacy SQL inventory has a noncanonical member")
+        if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
+            raise RuntimeError("legacy SQL bytes differ from the built inventory")
+    return {package / name for name in actual}
+
+
+def refuse_retained_migration_write() -> None:
+    """Compatibility permits cold reads, not legacy migration orchestration."""
+    if retained_home() is not None:
+        raise RuntimeError("legacy retained runtime has no migration-write authority")
diff --git a/tests/shared/test_retained_legacy.py b/tests/shared/test_retained_legacy.py
new file mode 100644
index 000000000..a2b19cf71
--- /dev/null
+++ b/tests/shared/test_retained_legacy.py
@@ -0,0 +1,59 @@
+"""Legacy path compatibility contracts; actual installed cold boot is separate CI."""
+
+from pathlib import Path
+
+import pytest
+
+from shared import dotenv_boot, retained_legacy
+
+
+def _image(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> Path:
+    home = tmp_path / "unit"
+    prefix = home / "releases" / ("a" * 64) / "venv"
+    prefix.mkdir(parents=True)
+    monkeypatch.setattr(retained_legacy, "_PREFIX", prefix)
+    monkeypatch.setattr(retained_legacy, "_INSTALLED", True)
+    monkeypatch.setattr(retained_legacy.sys, "prefix", str(prefix))
+    return home
+
+
+def test_loaded_image_requires_its_exact_home(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    home = _image(monkeypatch, tmp_path)
+    monkeypatch.setenv("AVA_HOME", str(home))
+    assert dotenv_boot.resolve_ava_home() == (home, True)
+
+
+@pytest.mark.parametrize("wrong", [None, "relative", "/other/unit"])
+def test_loaded_home_cannot_be_overridden(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, wrong: str | None
+) -> None:
+    _image(monkeypatch, tmp_path)
+    monkeypatch.setenv("AVA_HOME_OVERRIDE", "1")
+    if wrong is None:
+        monkeypatch.delenv("AVA_HOME", raising=False)
+    else:
+        monkeypatch.setenv("AVA_HOME", wrong)
+    with pytest.raises(dotenv_boot.AvaHomeContradictionError):
+        dotenv_boot.resolve_ava_home()
+
+
+def test_installed_non_generation_venv_refused(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _image(monkeypatch, tmp_path)
+    monkeypatch.setattr(retained_legacy, "_PREFIX", tmp_path / "random" / "venv")
+    with pytest.raises(RuntimeError, match="canonical release image"):
+        retained_legacy.retained_home()
+
+
+def test_plugin_reads_remain_bound_after_mutable_home_changes(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    home = _image(monkeypatch, tmp_path)
+    expected = home / "releases" / ("a" * 64) / "plugins"
+    assert retained_legacy.external_plugin_read_root() == expected
+    monkeypatch.setenv("AVA_HOME", str(tmp_path / "poison"))
+    assert retained_legacy.external_plugin_read_root() == expected
+    assert not expected.exists()

