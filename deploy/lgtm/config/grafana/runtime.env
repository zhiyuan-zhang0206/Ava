# Runtime-neutral Grafana behavior.  The current compose launcher and the
# planned native launcher must both consume this file.

# Dashboard Trace links open Explore.  Viewers may inspect and make temporary
# edits but still cannot persist dashboards.
GF_USERS_VIEWERS_CAN_EDIT=true

# Ava dashboards do not use Grafana Live.  Disable the endpoint instead of
# accepting a stream of unusable anonymous WebSocket handshakes.
GF_LIVE_MAX_CONNECTIONS=0

# Grafana 13.1.3 can surface SQLITE_BUSY while dashboard readers overlap its
# metadata writes.  Retry locked queries with bounded exponential backoff.
GF_DATABASE_QUERY_RETRIES=5

# Native Grafana (2026-08-23): the dashboard provider resolves relative
# paths against the process CWD, so point it at the checked-out
# provisioning dir (dashboards.yml `$__env` expansion).
GRAFANA_PROVISIONING_PATH=/Users/zyonzhang/.ava/source/deploy/lgtm/config/grafana/provisioning/dashboards
