{
 "uid": "ava-host-dataplane",
 "title": "Ava Host & Data Plane",
 "tags": [
  "ava",
  "infrastructure"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "host",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "CPU utilization",
   "description": "Non-idle CPU averaged over the machine's cores. Alert R8 fires above 0.90 sustained 15m.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg by (host) (system_cpu_utilization_ratio{state=\"idle\"})",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Memory used",
   "description": "Used fraction of RAM, reclaimable cache excluded \u2014 real pressure. Alert R9 above 0.90 sustained 15m.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg by (host) (system_memory_utilization_ratio{state=\"used\"})",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Load average",
   "description": "Runnable-thread load. Compare against the machine's core count, which the CPU panel normalizes away.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "system_cpu_load_average_1m",
     "legendFormat": "{{host}} 1m"
    },
    {
     "refId": "B",
     "expr": "system_cpu_load_average_5m",
     "legendFormat": "{{host}} 5m"
    },
    {
     "refId": "C",
     "expr": "system_cpu_load_average_15m",
     "legendFormat": "{{host}} 15m"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Filesystem used",
   "description": "Per-mountpoint fullness \u2014 the pg data dir, the traces mirror and the LGTM volumes live on these. Alert R10 above 0.90. On macOS every volume of one APFS container reports the container's fullness.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host, mountpoint) (system_filesystem_utilization_ratio)",
     "legendFormat": "{{host}} {{mountpoint}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Disk throughput",
   "description": "Bytes read/written per second across all devices.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 17
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host, direction) (rate(system_disk_io_bytes_total[5m]))",
     "legendFormat": "{{host}} {{direction}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Network throughput",
   "description": "Bytes per second across physical + tunnel interfaces (the sidecar filters macOS's virtual ones out).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 17
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host, direction) (rate(system_network_io_bytes_total[5m]))",
     "legendFormat": "{{host}} {{direction}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "type": "row",
   "title": "data plane",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 25
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Postgres connections",
   "description": "Open backends against the server's own max_connections. Alert R11 fires above 80% of max. PgBouncer has no OTel receiver \u2014 pool saturation surfaces here, at Postgres.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 26
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host) (postgresql_backends)",
     "legendFormat": "{{host}} backends"
    },
    {
     "refId": "B",
     "expr": "max by (host) (postgresql_connection_max)",
     "legendFormat": "{{host}} max_connections"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Postgres transactions",
   "description": "Commit and rollback rate. A rollback rate tracking the commit rate means transactions are failing, not that traffic is low.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 26
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host) (rate(postgresql_commits_total[5m]))",
     "legendFormat": "{{host}} commits/s"
    },
    {
     "refId": "B",
     "expr": "sum by (host) (rate(postgresql_rollbacks_total[5m]))",
     "legendFormat": "{{host}} rollbacks/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Database size",
   "description": "On-disk size of the cluster's own database \u2014 the slow half of the disk-watermark story.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 34
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host) (postgresql_db_size_bytes)",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Redis memory",
   "description": "Resident Redis footprint. Alert R12 fires above 2 GiB sustained; rss above used means fragmentation.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 34
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host) (redis_memory_used_bytes)",
     "legendFormat": "{{host}} used"
    },
    {
     "refId": "B",
     "expr": "max by (host) (redis_memory_rss_bytes)",
     "legendFormat": "{{host}} rss"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Redis clients and evictions",
   "description": "Any eviction rate above zero means Redis hit maxmemory and is dropping live keys \u2014 cluster state loss, not a cache miss.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 42
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host) (redis_clients_connected)",
     "legendFormat": "{{host}} clients"
    },
    {
     "refId": "B",
     "expr": "sum by (host) (rate(redis_keys_evicted_total[5m]))",
     "legendFormat": "{{host}} evictions/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Redis throughput",
   "description": "Commands per second, as Redis itself reports it.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 42
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (host) (redis_commands_per_second)",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
 ]
}
