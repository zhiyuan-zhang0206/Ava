{
 "uid": "ava-overview",
 "title": "Ava Overview",
 "tags": [
  "ava",
  "telemetry"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Agent turns",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(rate(ava_turn_end_duration_seconds_count[5m])) by (agent_id)",
     "legendFormat": "agent {{agent_id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "drawStyle": "line"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "LLM tokens / min",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(rate(ava_llm_usage_in_total[5m]))",
     "legendFormat": "input"
    },
    {
     "expr": "sum(rate(ava_llm_usage_out_total[5m]))",
     "legendFormat": "output"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "LLM latency p95 (ms)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(ava_llm_usage_latency_milliseconds_bucket[5m])) by (le))",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "SDK calls / min (by process)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum(rate(ava_sdk_call_duration_seconds_count[5m])) by (process)",
     "legendFormat": "{{process}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "drawStyle": "line"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Ava events (Loki)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "expr": "{scope_name=\"ava.telemetry\"}",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "sortOrder": "Descending"
   }
  },
  {
   "id": 6,
   "type": "table",
   "title": "Recent traces (Tempo)",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "targets": [
    {
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "query": "{resource.service.name=\"ava\"}",
     "queryType": "traceql",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ]
}
