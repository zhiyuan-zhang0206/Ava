      "title": "Empty recall ratio",
      "type": "timeseries",
      "description": "Share of INFO runs where filtering kept 0 notes (body 'N candidate(s) -> 0 kept') \u2014 recall-quality signal: a high share means retrieval/filtering usually judges nothing relevant (event_name='recall_filter', category='telemetry').",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "100 * sum(count_over_time({service_name=\"unknown_service\"} | json | category=~\"telemetry|log\" | event_name=\"recall_filter\" | level=\"info\" | attributes_body =~ \".*-> 0 kept.*\" [$__interval])) / sum(count_over_time({service_name=\"unknown_service\"} | json | category=~\"telemetry|log\" | event_name=\"recall_filter\" | level=\"info\" [$__interval]))",
          "refId": "A",
