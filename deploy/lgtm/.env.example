# deploy/lgtm — observability backend environment. Copy to .env (gitignored)
# and adjust before `docker compose up -d`; all values have working defaults,
# so this file is optional.

# Public URL of the Grafana UI (used for redirects), e.g. a VPN overlay
# address when the machine is reached over a private network.
GRAFANA_ROOT_URL=http://localhost:3003

# Alerting webhook token — the Grafana alert contact point sends it as a
# Bearer credential (contact.yml $__env expansion via docker-compose). Must
# match the gateway's AVA_ALERTS_WEBHOOK_TOKEN in ~/.ava/.env. Copy to
# .env — never commit.
AVA_ALERTS_WEBHOOK_TOKEN=

# Read-only Postgres password for the Grafana datasource (role grafana_ro,
# SELECT on agents_meta/events only). Created on the gateway host:
#   psql -h /tmp/ava-pg-ava-*/ -p 5433 -U <os-user> -d ava_main #     -c "CREATE ROLE grafana_ro LOGIN PASSWORD '<pw>'" #     -c "GRANT CONNECT ON DATABASE ava_main TO grafana_ro" #     -c "GRANT USAGE ON SCHEMA public TO grafana_ro" #     -c "GRANT SELECT ON agents_meta TO grafana_ro" #     -c "GRANT SELECT ON events TO grafana_ro"
# Alphanumeric only (Grafana $VAR expansion eats $ chars). Never commit.
GRAFANA_PG_PASSWORD=
