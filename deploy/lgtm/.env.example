# deploy/lgtm — secret-bearing observability backend environment. Copy to .env
# (gitignored) only when configuring the optional datasource/webhook secrets.
# Lifecycle supplies GRAFANA_ROOT_URL from AVA_GATEWAY_URL + /grafana/; it is
# deliberately absent here so a stale direct :3003 public URL cannot win.

# Alerting webhook token — kept for the 3002-era host-side Grafana
# (dashboards/ops/alerts/contact.yml sends it as X-Ops-Alerts-Token).
# Must match the gateway's AVA_ALERTS_WEBHOOK_TOKEN (legacy
# AVA_OPS_ALERTS_WEBHOOK_TOKEN in ~/.ava/.env). Copy to .env — never commit.
OPS_ALERTS_WEBHOOK_TOKEN=

# Read-only Postgres password for the Grafana datasource (role grafana_ro,
# SELECT on agents_meta/events only). Created on the gateway host:
#   psql -h /tmp/ava-pg-ava-*/ -p 5433 -U <os-user> -d ava_main #     -c "CREATE ROLE grafana_ro LOGIN PASSWORD '<pw>'" #     -c "GRANT CONNECT ON DATABASE ava_main TO grafana_ro" #     -c "GRANT USAGE ON SCHEMA public TO grafana_ro" #     -c "GRANT SELECT ON agents_meta TO grafana_ro" #     -c "GRANT SELECT ON events TO grafana_ro"
# Alphanumeric only (Grafana $VAR expansion eats $ chars). Never commit.
GRAFANA_PG_PASSWORD=
