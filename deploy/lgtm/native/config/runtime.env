# Converge-rendered native Grafana environment. The same GF_* values remain
# in config/grafana/runtime.env for the manual compose rollback path.
GF_USERS_VIEWERS_CAN_EDIT=true
GF_LIVE_MAX_CONNECTIONS=0
GF_DATABASE_QUERY_RETRIES=5
GRAFANA_PROVISIONING_PATH={{GRAFANA_PROVISIONING_PATH}}
AVA_TELEMETRY_TEMPO_QUERY_URL={{AVA_TEMPO_QUERY_URL}}
# Datasource + alert-webhook URLs: two-state on AVA_OBSERVABILITY_URL (empty =
# loopback defaults, byte-identical to the pre-parameterization behavior;
# non-empty = observatory station / gateway reachable host). The datasources.yml
# and contact.yml provisioning files reference these via $__env{} expansion.
AVA_TELEMETRY_LOKI_URL={{LOKI_URL}}
AVA_TELEMETRY_PROMETHEUS_URL={{PROMETHEUS_URL}}
AVA_PG_URL={{PG_URL}}
AVA_ALERTS_WEBHOOK_URL={{ALERTS_WEBHOOK_URL}}
