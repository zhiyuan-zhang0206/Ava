# Converge-rendered native Grafana environment.
GF_USERS_VIEWERS_CAN_EDIT=true
GF_LIVE_MAX_CONNECTIONS=0
GF_DATABASE_QUERY_RETRIES=5
GRAFANA_PROVISIONING_PATH={{GRAFANA_PROVISIONING_PATH}}
MEIVA_TELEMETRY_TEMPO_QUERY_URL={{MEIVA_TEMPO_QUERY_URL}}
# Loki/Prometheus follow MEIVA_OBSERVABILITY_URL; PG follows the direct data-plane
# configuration. Alerts use the local gateway bind port or its configured
# reachable URL for a remote observatory. Grafana expands these values in the
# datasources.yml and contact.yml provisioning files via $__env{} references.
MEIVA_TELEMETRY_LOKI_URL={{LOKI_URL}}
MEIVA_TELEMETRY_PROMETHEUS_URL={{PROMETHEUS_URL}}
MEIVA_PG_URL={{PG_URL}}
MEIVA_ALERTS_WEBHOOK_URL={{ALERTS_WEBHOOK_URL}}
