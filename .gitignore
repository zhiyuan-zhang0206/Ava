# Claude Code session artifacts
.claude/
.claude-agent/
.superpowers/
.worktrees/

# `.claude/skills` is a TRACKED symlink (→ .agents/skills) — keep it out of
# the ignore so a fresh-init snapshot does not silently drop it.
!.claude/skills

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Per-checkout home pointer: maps a dev worktree to its cluster's $AVA_HOME so
# bare invocations resolve the right home (written by `ava gateway up`).
.ava_home

# Secrets
.env
.env.local
.env.*.local
# Local multi-host test rig: per-container env files hold issued machine keys.
.multihost/

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# e2e artifacts
tmp/

# Benchmark / eval transient outputs (predictions, JSONL, cloned repos, harness logs)
runs/
logs/

# Docker volumes live in Docker, not in the repo

# coverage
htmlcov/
.coverage
coverage.xml

coverage/

# Node (for skills that bundle JS helpers)
node_modules/
/frontend/.builds/

# mutmut workdir
mutants/

# Stryker.js workdir + reports
frontend/reports/
.stryker-tmp/
frontend/.stryker-tmp/

# metrics.py raw reports (keep the dir, ignore the reports)
outputs/*
!outputs/.gitkeep

# Claude Code collaboration files
tasks.md
work.md

# Agent workspace artifacts
.shell_logs/
.exec_output/

# OKF viz build artifact (generated by scripts/serve_okf_viz.py)
okf-d3.html

# Stray per-agent memory files: some agents run with the repo checkout itself
# as cwd (task work on this repo) and their memory-writing path lands at cwd
# instead of the proper $AVA_HOME/workspaces/<id>/memory/ (agent/graph/_memory_inject.py).
# These are debris, not the documented per-agent memory location — see
# PR disposition notes from an earlier root-strays cleanup.
/MEMORY.md
/memory/
/frontend/MEMORY.md
/.ava/agents/
# Scratch notes agents leave in the repo root.
/task564-notes.md

# Scratch files agents write when composing a commit message. One of these
# (.commit_msg.txt) is a transient scratch file.
/.commit_msg.txt
/commit_msg.txt
